[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/station_hub.gd" id="1_hub"]
[ext_resource type="Theme" path="res://themes/maritime_wood_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_drawer"]
bg_color = Color(0.086, 0.051, 0.027, 0.96)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
